FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @betna/api exec prisma generate
RUN pnpm --filter @betna/config build
RUN pnpm --filter @betna/contracts build
RUN pnpm --filter @betna/api build
RUN pnpm --filter=@betna/api deploy --prod /app/deploy
RUN cp -R apps/api/dist /app/deploy/dist && cp -R apps/api/prisma /app/deploy/prisma
RUN cd /app/deploy && pnpm exec prisma generate --schema=prisma/schema.prisma

FROM gcr.io/distroless/nodejs22-debian13:nonroot AS runtime

WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/deploy ./
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:'+(process.env.API_PORT||4000)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["dist/src/main.js"]
