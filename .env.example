# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public API origin used in visitor location-redemption links.
PUBLIC_API_URL=http://localhost:4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100
# The documented pnpm dev flow runs web and API on the host. Override this to
# http://api:4000 only when the web is running in a Docker service named `api`.
API_INTERNAL_URL=http://localhost:4000
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ti
SESSION_SECRET=replace-with-a-long-random-development-secret
JWT_SECRET=replace-with-a-long-random-development-secret

# PostgreSQL/PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=betna
POSTGRES_USER=betna
POSTGRES_PASSWORD=betna-local-password
DATABASE_URL=postgresql://betna:betna-local-password@localhost:5432/betna

# Redis/BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=betna-local
S3_SECRET_ACCESS_KEY=betna-local-secret
S3_PUBLIC_BUCKET=betna-public
S3_PRIVATE_BUCKET=betna-private
MEDIA_STORAGE_PROVIDER=fake
MINIO_ROOT_USER=betna-local
MINIO_ROOT_PASSWORD=betna-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional outbound integrations (leave blank for local development)
EMAIL_FROM=noreply@example.test
EMAIL_PROVIDER=log
WHATSAPP_PROVIDER=log
SMS_PROVIDER=log
MAPS_PROVIDER=none

# Production outbound providers (required when NODE_ENV=production)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=Betna <noreply@example.com>
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=replace-with-meta-cloud-api-token
# WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
# WHATSAPP_API_VERSION=v21.0
