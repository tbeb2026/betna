{
  "name": "betna",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "body-parser": "1.20.9",
      "deepmerge-ts": "8.0.0",
      "effect": "3.22.1",
      "glob": "10.5.0",
      "multer": "2.5.0",
      "picomatch": "4.0.4",
      "postcss": "8.5.18",
      "tmp": "0.2.7"
    }
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:integration": "pnpm --filter @betna/api test:db",
    "test:db": "pnpm --filter @betna/api test:db",
    "test:e2e": "turbo test:e2e",
    "test:playwright": "pnpm --filter @betna/web test:e2e",
    "typecheck": "turbo typecheck",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.0"
  }
}
